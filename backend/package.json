{
  "name": "gpc-api",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "start:local": "node src/server.js",
    "test": "node --env-file-if-exists=.env --test",
    "backup": "node --env-file=.env scripts/backup-db.mjs",
    "restore": "node --env-file=.env scripts/restore-db.mjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "role": "node --env-file=.env scripts/set-role.mjs",
    "demo:seed": "node --env-file=.env scripts/demo-seed.mjs",
