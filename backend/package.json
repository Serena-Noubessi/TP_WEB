    "demo:start": "node --env-file=.env scripts/demo-start.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "mongoose-aggregate-paginate-v2": "^1.1.5",
    "multer": "^2.0.2"
