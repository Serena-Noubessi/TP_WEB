MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/guitar-practice-cloud?retryWrites=true&w=majority
# Secret des jetons de connexion : long et aléatoire (32 caractères minimum, obligatoire en production).
# Exemple pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-local-secret
PORT=3000
# Production : NODE_ENV=production refuse de démarrer sans vrai JWT_SECRET.
# NODE_ENV=production
# Production : adresse(s) du site autorisée(s) à appeler l'API (séparées par des virgules).
# CORS_ORIGIN=https://mostvibe.exemple.fr
# Mise en ligne en un seul service : dossier du site Angular compilé, servi par ce serveur.
# FRONTEND_DIST=../frontend-starter/dist/gpc/browser
# Facultatif : nom d'une autre base (démonstration, tests). Par défaut, celle de MONGODB_URI.
# MONGODB_DB=most-vibe-demo
